+.subtitle { font-size: .85rem; color: #888; margin: 4px 0 0; }
+.btn-create { padding: 10px 20px; background: #4a6b8a; color: #fff; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: .9rem; }
+
+.tabs { display: flex; gap: 4px; margin-bottom: 14px; }
+.tabs button { padding: 8px 18px; border: none; border-radius: 8px; background: #f0f0f0; color: #555; cursor: pointer; font-weight: 600; font-size: .85rem; }
+.tabs button.active { background: #4a6b8a; color: #fff; }
+
+.filters-bar { display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
+.filter-select { padding: 10px 14px; border: 1.5px solid #e0e0e0; border-radius: 8px; font-size: .88rem; background: #fff; min-width: 130px; }
+
+.stats-row { display: flex; gap: 12px; margin-bottom: 14px; }
+.stat-item { background: #fff; border-radius: 10px; padding: 12px 18px; display: flex; flex-direction: column; align-items: center; box-shadow: 0 1px 3px rgba(0,0,0,.04); min-width: 80px; }
+.stat-val { font-size: 1.3rem; font-weight: 700; color: #1a1a2e; }
+.stat-lbl { font-size: .68rem; color: #888; text-transform: uppercase; }
+
+.table-wrap { background: #fff; border-radius: 12px; box-shadow: 0 1px 3px rgba(0,0,0,.04); overflow-x: auto; }
+.report-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
+.report-table th { text-align: left; padding: 10px 14px; background: #f8f9fb; color: #888; font-size: .72rem; text-transform: uppercase; letter-spacing: .3px; border-bottom: 1px solid #eee; }
+.report-table td { padding: 10px 14px; border-bottom: 1px solid #f0f0f0; color: #1a1a2e; }
+.report-table .mono { font-family: monospace; font-size: .78rem; color: #888; }
+.report-table .empty { text-align: center; color: #aaa; padding: 30px; }
+.pct { font-weight: 700; }
+.pct.good { color: #2d6a4f; }
+.pct.warn { color: #ba7517; }
+.pct.bad { color: #b0473f; }
+.loading { text-align: center; padding: 40px; color: #888; }
