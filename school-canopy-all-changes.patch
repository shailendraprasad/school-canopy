+        <div class="form-group"><label>Name *</label><input [(ngModel)]="name" name="name" required placeholder="e.g. Mathematics" /></div>
+        <div class="form-group"><label>Code</label><input [(ngModel)]="code" name="code" placeholder="e.g. MATH" /></div>
+        <div class="form-actions">
+          <button type="button" (click)="showForm.set(false)" class="btn-cancel">Cancel</button>
+          <button type="submit" class="btn-submit" [disabled]="!name">Create</button>
+        </div>
+      </form>
+    </div>
+  </div>
+}
+
+@if (showAssignForm()) {
+  <div class="modal-overlay" (click)="showAssignForm.set(false)">
+    <div class="modal" (click)="$event.stopPropagation()">
+      <h3>Assign Teacher to Subject</h3>
+      <form (ngSubmit)="assign()" class="form">
+        <div class="form-group">
+          <label>Subject *</label>
+          <select [(ngModel)]="assignSubjectId" name="assignSubjectId" required>
+            <option value="">Select...</option>
+            @for (s of subjects(); track s.id) { <option [value]="s.id">{{ s.name }}</option> }
+          </select>
+        </div>
+        <div class="form-group">
+          <label>Teacher *</label>
+          <select [(ngModel)]="assignTeacherId" name="assignTeacherId" required>
+            <option value="">Select...</option>
+            @for (t of teachers(); track t.id) { <option [value]="t.id">{{ t.name }}</option> }
+          </select>
+        </div>
+        <div class="form-row">
+          <div class="form-group">
+            <label>Class *</label>
+            <select [(ngModel)]="assignClassId" name="assignClassId" required>
+              <option value="">Select...</option>
+              @for (c of classes(); track c.id) { <option [value]="c.id">{{ c.name }}</option> }
+            </select>
+          </div>
+          <div class="form-group">
+            <label>Section *</label>
+            <select [(ngModel)]="assignSectionId" name="assignSectionId" required [disabled]="!assignClassId">
+              <option value="">Select...</option>
+              @for (s of assignSections; track s.id) { <option [value]="s.id">{{ s.name }}</option> }
+            </select>
+          </div>
+        </div>
+        <div class="form-actions">
+          <button type="button" (click)="showAssignForm.set(false)" class="btn-cancel">Cancel</button>
+          <button type="submit" class="btn-submit" [disabled]="!assignSubjectId || !assignTeacherId || !assignSectionId">Assign</button>
+        </div>
+      </form>
+    </div>
+  </div>
+}
diff --git a/school-portal/src/app/pages/subjects/subjects.component.ts b/school-portal/src/app/pages/subjects/subjects.component.ts
new file mode 100644
index 0000000..bc292b7
--- /dev/null
+++ b/school-portal/src/app/pages/subjects/subjects.component.ts
@@ -0,0 +1,85 @@
+import { Component, OnInit, signal } from '@angular/core';
+import { CommonModule } from '@angular/common';
+import { FormsModule } from '@angular/forms';
+import { ApiService } from '../../services/api.service';
+
+@Component({
+  selector: 'app-subjects',
+  standalone: true,
+  imports: [CommonModule, FormsModule],
+  templateUrl: './subjects.component.html',
+  styleUrl: './subjects.component.css'
+})
+export class SubjectsComponent implements OnInit {
+  subjects = signal<any[]>([]);
+  assignments = signal<any[]>([]);
+  teachers = signal<any[]>([]);
+  classes = signal<any[]>([]);
+  sections = signal<any[]>([]);
+  message = signal('');
+  error = signal('');
+  showForm = signal(false);
+  showAssignForm = signal(false);
+
+  name = '';
+  code = '';
+  assignSubjectId = '';
+  assignTeacherId = '';
+  assignClassId = '';
+  assignSectionId = '';
+
+  constructor(private api: ApiService) {}
+
+  ngOnInit() {
+    this.load();
+    this.api.get<any[]>('/api/school/teachers').subscribe(res => this.teachers.set(res.data || []));
+    this.api.get<any[]>('/api/school/classes').subscribe(res => this.classes.set(res.data || []));
+    this.api.get<any[]>('/api/school/sections').subscribe(res => this.sections.set(res.data || []));
+  }
+
+  load() {
+    this.api.get<any[]>('/api/school/subjects').subscribe(res => this.subjects.set(res.data || []));
+    this.api.get<any[]>('/api/school/subjects/assignments').subscribe(res => this.assignments.set(res.data || []));
+  }
+
+  get assignSections(): any[] {
+    if (!this.assignClassId) return [];
+    return this.sections().filter(s => s.classId === this.assignClassId);
+  }
+
+  create() {
+    this.error.set('');
+    this.api.post('/api/school/subjects', { name: this.name, code: this.code }).subscribe({
+      next: () => {
+        this.name = ''; this.code = '';
+        this.showForm.set(false);
+        this.message.set('Subject created');
+        this.load();
+      },
+      error: err => this.error.set(err.error?.errors?.[0]?.message || 'Failed to create subject')
+    });
+  }
+
+  assign() {
+    this.error.set('');
+    this.api.post(`/api/school/subjects/${this.assignSubjectId}/assign`, {
+      teacherId: this.assignTeacherId,
+      sectionId: this.assignSectionId
+    }).subscribe({
+      next: () => {
+        this.showAssignForm.set(false);
+        this.assignSubjectId = ''; this.assignTeacherId = ''; this.assignClassId = ''; this.assignSectionId = '';
+        this.message.set('Teacher assigned to subject');
+        this.load();
+      },
+      error: err => this.error.set(err.error?.errors?.[0]?.message || 'Failed to assign')
+    });
+  }
+
+  unassign(id: string) {
+    this.api.delete(`/api/school/subjects/assignments/${id}`).subscribe({
+      next: () => { this.message.set('Assignment removed'); this.load(); },
+      error: () => {}
+    });
+  }
+}
